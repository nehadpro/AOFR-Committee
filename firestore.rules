rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // أعضاء اللجنة — تُقرأ لملء قائمة الدخول، وتُكتب من لوحة تحكم المسؤول
    // ومن العضو نفسه عند تغيير كلمة المرور.
    match /members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // اللجان والموضوعات المرتبطة بها
    match /committees/{committeeId} {
      allow read: if true;
      allow write: if true;

      match /topics/{topicId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}

// ============================================================
// ملاحظة أمان مهمة:
// هذه القواعد مفتوحة عمدًا لأن النظام لا يستخدم "Firebase Authentication"
// الحقيقي، بل تسجيل دخول مبسّط باسم العضو (وكلمة مرور اختيارية) يتحقق منه
// المتصفح مباشرة. أي شخص يعرف رابط الموقع (ورابط قاعدة البيانات الظاهر
// داخل ملفات الموقع) يستطيع تقنيًا قراءة/تعديل البيانات مباشرة متجاوزًا
// الواجهة، تمامًا كما يمكنه فعل أي تعديل عبر أدوات المطوّر في المتصفح.
// هذا مقبول لأداة داخلية بين ٨ أعضاء موثوقين، وليس مناسبًا لبيانات حساسة
// جدًا أو نظام عام. لتقوية الحماية لاحقًا:
//   1) قيّد مفتاح API بنطاق موقعك (Google Cloud Console → Credentials →
//      HTTP referrers) حتى لا يُستخدم من مواقع أخرى.
//   2) في خطوة لاحقة، يمكن الانتقال إلى Firebase Authentication الحقيقي
//      (تسجيل دخول فعلي بالبريد وكلمة مرور موثقة من طرف الخادم) وربط
//      القواعد بهوية المستخدم الفعلية بدل الاعتماد على منطق الواجهة فقط.
// ============================================================
